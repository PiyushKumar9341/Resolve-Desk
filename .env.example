# Server Configuration
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/student_grievance_db
JWT_SECRET=your_jwt_secret_key_here

# Email SMTP Credentials (Gmail App Password)
# If left empty, OTP will be logged to console and shown in dev notification badge
EMAIL_SERVICE=gmail
EMAIL_USER=your_college_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Environment
NODE_ENV=development
